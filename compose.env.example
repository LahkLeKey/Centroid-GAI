POSTGRES_DB=centroid_gai
POSTGRES_USER=centroid_gai
POSTGRES_PASSWORD=replace-this-outside-development
POSTGRES_PORT=5432
API_PORT=3000
MAX_REQUEST_BYTES=67108864

# Chat and memory require this token for Docker-network clients; choose a private value.
CGAI_CHAT_API_TOKEN=
CGAI_CHAT_OWNER_ID=local-owner
# Blank defaults to Wikipedia, or SearXNG when a URL is supplied below.
# Set disabled for offline operation. Unsupported messages otherwise trigger research.
CGAI_SEARCH_PROVIDER=
# Optional public SearXNG /search endpoint with JSON enabled for broader web search.
CGAI_SEARCH_URL=

# Repository overlay: docker compose -f compose.yaml -f compose.repository.yaml up --build --detach --wait
# Bootstrap a committed snapshot before enabling the overlay; the mount is read-only.
CGAI_REPOSITORY_ROOT_HOST=./build/knowledge/repository
CGAI_REPOSITORY_REF=
# JSON array of additional container paths to explicitly switch to in conversations.
CGAI_REPOSITORY_ADDITIONAL_SNAPSHOTS=[]

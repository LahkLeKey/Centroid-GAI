{
  "version": 1,
  "purpose": "closed-vocabulary-memorization-sanity",
  "description": "Thirteen authored toy dialogues isolate fitting and free-running EOS from unseen vocabulary. All cases are training cases; no held-out or factual generalization claim is made.",
  "cases": [
    { "id": "direct-red", "category": "direct", "messages": [{ "role": "user", "content": "warm" }], "answer": "red" },
    { "id": "direct-blue", "category": "direct", "messages": [{ "role": "user", "content": "cool" }], "answer": "blue" },
    { "id": "direct-green", "category": "direct", "messages": [{ "role": "user", "content": "go" }], "answer": "green" },
    { "id": "direct-yellow", "category": "direct", "messages": [{ "role": "user", "content": "sunrise" }], "answer": "yellow" },
    { "id": "evidence-red", "category": "evidence", "messages": [{ "role": "evidence", "content": "red" }, { "role": "user", "content": "signal" }], "answer": "red" },
    { "id": "evidence-blue", "category": "evidence", "messages": [{ "role": "evidence", "content": "blue" }, { "role": "user", "content": "signal" }], "answer": "blue" },
    { "id": "evidence-green", "category": "evidence", "messages": [{ "role": "evidence", "content": "green" }, { "role": "user", "content": "signal" }], "answer": "green" },
    { "id": "followup-red", "category": "follow-up", "messages": [{ "role": "user", "content": "remember red" }, { "role": "assistant", "content": "red" }, { "role": "user", "content": "repeat" }], "answer": "red" },
    { "id": "followup-blue", "category": "follow-up", "messages": [{ "role": "user", "content": "remember blue" }, { "role": "assistant", "content": "blue" }, { "role": "user", "content": "repeat" }], "answer": "blue" },
    { "id": "correction", "category": "correction", "messages": [{ "role": "user", "content": "remember red" }, { "role": "assistant", "content": "red" }, { "role": "user", "content": "use blue" }], "answer": "blue" },
    { "id": "abstain", "category": "abstention", "messages": [{ "role": "user", "content": "unknown" }], "answer": "insufficient evidence" },
    { "id": "clarify", "category": "clarification", "messages": [{ "role": "user", "content": "which" }], "answer": "please clarify" },
    { "id": "evidence-removed", "category": "abstention", "messages": [{ "role": "user", "content": "signal" }], "answer": "insufficient evidence" }
  ],
  "controls": [
    { "id": "swap-red-blue", "kind": "swapped", "sourceCaseId": "evidence-red", "targetCaseId": "evidence-blue" },
    { "id": "swap-blue-green", "kind": "swapped", "sourceCaseId": "evidence-blue", "targetCaseId": "evidence-green" },
    { "id": "swap-green-red", "kind": "swapped", "sourceCaseId": "evidence-green", "targetCaseId": "evidence-red" },
    { "id": "remove-red", "kind": "removed", "sourceCaseId": "evidence-red", "targetCaseId": "evidence-removed" },
    { "id": "remove-blue", "kind": "removed", "sourceCaseId": "evidence-blue", "targetCaseId": "evidence-removed" },
    { "id": "remove-green", "kind": "removed", "sourceCaseId": "evidence-green", "targetCaseId": "evidence-removed" }
  ]
}

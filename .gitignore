# Data and model output are local unless explicitly admitted below.
# Keep raw acquisition, generated datasets, reviews and training runs out of Git.
/data/**
/models/**

# These small authored JSON fixtures are required by offline tests and evaluators.
!/data/chat/
!/data/chat/factual-dialogues-v2.json
!/data/chat/learning-sanity-v1.json
!/data/chat/train-request-v1.json
# Research collection state stays local; only the authored policy is published.
!/data/research/
!/data/research/autotrain.json

# The tiny authored ordering corpus is part of this pinned replay recipe.
!/models/neural/
!/models/neural/order-v1/
!/models/neural/order-v1/train.txt

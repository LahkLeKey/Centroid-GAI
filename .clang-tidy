# Annex K is optional in C11 and unavailable on several supported platforms.
Checks: '-*,clang-analyzer-*,-clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,bugprone-sizeof-expression,bugprone-suspicious-memset-usage,readability-function-size'
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|[/\\])(src|include|tests|persistence[/\\]prisma-postgres[/\\]native)[/\\].*\.(c|h)$'
FormatStyle: file
CheckOptions:
  # Keep the line check permissive because detailed comments are part of the
  # implementation contract; statements remain capped at twenty.
  - key: readability-function-size.LineThreshold
    value: '1000'
  - key: readability-function-size.StatementThreshold
    value: '20'
  - key: readability-function-size.BranchThreshold
    value: '8'
  - key: readability-function-size.ParameterThreshold
    value: '7'

{
    "name": "@centroid-gai/db",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.11"
    },
    "exports": {
        ".": "./src/prisma/db.ts",
        "./contract": "./src/prisma/contract.d.ts"
    },
    "scripts": {
        "contract:emit": "prisma contract emit",
        "db:init": "prisma db init",
        "db:verify": "prisma db verify",
        "migration:plan": "prisma migration plan",
        "db:migrate": "prisma db migrate --advance-ref db",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@prisma/orm-postgres": "8.0.0-rc.11",
        "dotenv": "18.0.0",
        "temporal-polyfill": "1.0.5"
    },
    "devDependencies": {
        "@types/node": "24.10.1",
        "prisma": "8.0.0-rc.15",
        "typescript": "5.9.3"
    }
}
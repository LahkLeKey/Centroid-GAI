{
	"name": "@centroid-gai/api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.11"
	},
	"scripts": {
		"install": "node-gyp rebuild",
		"native:build": "node-gyp rebuild",
		"native:test": "node --test src/native.test.ts src/spatial.test.ts src/chat-native.test.ts src/chat/*.test.ts",
		"api:test": "node --test --test-concurrency=1 src/api.test.ts src/chat-api.test.ts",
		"baseline:test": "node --test src/evaluation/metrics.test.ts",
		"baseline": "node src/evaluation/benchmark.ts",
        "chat:evaluate": "node src/evaluation/chat.ts",
		"codebase:test": "node --test src/evaluation/codebase-data.test.ts",
		"codebase:verify": "node src/evaluation/codebase.ts",
		"repository:ask": "node src/knowledge/ask.ts",
		"repository:test": "node --test src/knowledge/retrieval.test.ts src/evaluation/repository-chat-metrics.test.ts src/evaluation/repository-chat-followups.test.ts src/evaluation/repository-chat-research.test.ts",
		"repository:evaluate": "node src/evaluation/repository.ts",
        "repository:chat:evaluate": "node src/evaluation/repository-chat.ts",
		"codebase:centroids": "node src/knowledge/codebase-centroids.ts",
		"codebase:centroids:test": "node --test src/knowledge/codebase-centroids.test.ts",
		"knowledge:compile:test": "node --test src/knowledge/compile-native-knowledge.test.ts",
		"test": "bun run native:test",
		"test:all": "bun run typecheck && bun run native:test && bun run api:test",
		"typecheck": "tsc --noEmit",
		"model": "node src/cli.ts",
		"start": "node src/server.ts"
	},
	"dependencies": {
		"@centroid-gai/db": "workspace:*",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"@types/node": "24.10.1",
		"node-gyp": "11.4.2"
	}
}

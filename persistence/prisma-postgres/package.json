{
  "name": "@centroid-gai/prisma-postgres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "install": "node-gyp rebuild",
    "native:build": "node-gyp rebuild",
    "native:test": "node --test src/native.test.ts",
    "api:test": "node --test src/api.test.ts",
    "test": "npm run native:test",
    "test:all": "npm run typecheck && npm run native:test && npm run api:test",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:verify": "prisma db verify",
    "migration:plan": "prisma migration plan",
    "db:migrate": "prisma db migrate --advance-ref db",
    "typecheck": "tsc --noEmit",
    "model": "node src/cli.ts",
    "start": "node src/server.ts"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "dotenv": "18.0.0",
    "temporal-polyfill": "1.0.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "node-gyp": "11.4.2",
    "prisma": "8.0.0-rc.15",
    "typescript": "5.9.3"
  }
}
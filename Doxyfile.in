PROJECT_NAME           = "Centroid-GAI"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "Centroid-based text generation in C"
OUTPUT_DIRECTORY       = @DOXYGEN_OUTPUT_DIR@
INPUT                  = @DOXYGEN_INPUT_DIR@
FILE_PATTERNS          = *.h
RECURSIVE              = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
QUIET                  = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES


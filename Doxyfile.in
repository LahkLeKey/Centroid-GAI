PROJECT_NAME           = "Centroid-GAI"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "Centroid-based text generation in C"
OUTPUT_DIRECTORY       = @DOXYGEN_OUTPUT_DIR@
INPUT                  = "@DOXYGEN_INPUT_DIR@" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/src" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/tests" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/persistence/api/native" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/c-reading-guide.md"
FILE_PATTERNS          = *.h *.c
RECURSIVE              = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = YES
WARN_NO_PARAMDOC       = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
QUIET                  = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE  = "@CMAKE_CURRENT_SOURCE_DIR@/docs/c-reading-guide.md"
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
REFERENCES_RELATION    = YES
REFERENCED_BY_RELATION = YES
HAVE_DOT               = NO

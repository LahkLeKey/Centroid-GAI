{
  "version": 1,
  "purpose": "repository-followup-development",
  "description": "Eight development-only calibration chains for source-mode references. These scenarios may guide implementation changes; they are not held-out acceptance data. They run and score separately from the unchanged forty-scenario repository regression suite.",
  "scenarios": [
    {
      "id": "followup-active-file-choice",
      "description": "A singular reference to several task files must be resolved before proposing a file-specific change.",
      "turns": [
        {
          "content": "What is the next unfinished step for the repository chatbot?",
          "expected": {
            "outcome": "action",
            "task": "source-followup-calibration",
            "state": {
              "taskId": "source-followup-calibration",
              "candidates": "none",
              "taskCandidates": "none",
              "focusPath": null
            }
          }
        },
        {
          "content": "Which one of those files should I edit?",
          "expected": {
            "outcome": "clarification",
            "finishReason": "clarification",
            "noAction": true,
            "state": {
              "focusPath": null,
              "candidates": "multiple",
              "candidateIncludes": [
                "persistence/api/src/chat/repository.ts",
                "persistence/api/src/chat/service.ts"
              ]
            }
          }
        },
        {
          "content": "I mean persistence/api/src/chat/repository.ts.",
          "expected": {
            "outcome": "supported",
            "state": {
              "taskId": "source-followup-calibration",
              "focusPath": "persistence/api/src/chat/repository.ts",
              "candidates": "none",
              "taskCandidates": "none"
            },
            "sourcePaths": [
              "persistence/api/src/chat/repository.ts"
            ]
          }
        },
        {
          "content": "Which checks are still needed?",
          "expected": {
            "outcome": "action",
            "task": "source-followup-calibration",
            "state": {
              "taskId": "source-followup-calibration",
              "candidates": "none",
              "taskCandidates": "none",
              "focusPath": "persistence/api/src/chat/repository.ts"
            }
          }
        }
      ],
      "group": "context",
      "split": "development"
    },
